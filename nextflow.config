// =============================================================================
// nextflow.config — Exhalo-Scan v2 Pipeline Configuration
// Nextflow 25.x: ALL default params must live here, not in main.nf
// =============================================================================

manifest {
    name            = 'Exhalo-Scan'
    author          = 'Niraj — IISER Tirupati'
    description     = 'Publication-Grade Multi-Omic VOC-based Respiratory Disease Classification'
    version         = '2.0.0'
    nextflowVersion = '>=23.04'
    mainScript      = 'main.nf'
}

// ---------------------------------------------------------------------------
// Default parameters
// ---------------------------------------------------------------------------
params {
    // Input / Output
    raw_data        = "${projectDir}/data/MTBLS70_VOC_peak_table.csv"
    outdir          = "${projectDir}/results"
    scripts         = "${projectDir}/scripts"

    // External validation (optional — provide paths to run this stage)
    ext_data        = null   // path to external VOC peak table CSV
    ext_meta        = null   // path to external metadata CSV (must have Diagnosis column)

    // Gene expression (optional — for multi-omics integration)
    gene_expr       = null   // CSV with columns: Gene, log2FC, adj_pvalue

    // Pre-processing
    pqn_reference   = "median"
    knn_k           = 5
    log_base        = "natural"
    missing_thresh  = 0.20

    // Batch correction
    batch_col       = "Batch"   // metadata column name; if absent → LOESS correction

    // Feature selection
    stability_threshold = 0.70  // fraction of CV folds a feature must be selected
    stability_folds     = 10    // number of CV folds for stability selection

    // Biomarker discovery (RF+SHAP — legacy)
    n_top_features  = 15
    rf_n_estimators = 500
    rf_random_state = 42

    // Classification
    xgb_n_estimators = 300
    xgb_max_depth    = 6
    xgb_lr           = 0.05
    n_outer_folds    = 5
    n_inner_folds    = 3

    // Enrichment / pathway
    fdr_cutoff       = 0.05
    min_pathway_size = 3
    min_overlap      = 2

    // Permutation test
    n_permutations   = 1000    // number of label permutations for significance testing

    // Annotation
    no_api           = false   // set true to skip all REST API calls (offline mode)

    // Visualisation
    dpi              = 300
    palette          = "magma"
}

// ---------------------------------------------------------------------------
// Default executor
// ---------------------------------------------------------------------------
executor {
    name   = 'local'
    cpus   = 16
    memory = '64 GB'
}

process {
    cpus   = 4
    memory = '8 GB'
    time   = '2h'

    withName: 'PREPROCESS' {
        cpus   = 2
        memory = '4 GB'
        time   = '30 min'
    }
    withName: 'BATCH_CORRECTION' {
        cpus   = 2
        memory = '4 GB'
        time   = '20 min'
    }
    withName: 'BIOMARKER_DISCOVERY' {
        cpus   = 8
        memory = '16 GB'
        time   = '1 h'
    }
    withName: 'FEATURE_SELECTION' {
        cpus   = 8
        memory = '16 GB'
        time   = '1 h'
    }
    withName: 'CLASSIFICATION' {
        cpus   = 8
        memory = '16 GB'
        time   = '2 h'
    }
    withName: 'CLASSIFICATION_ENHANCED' {
        cpus   = 8
        memory = '16 GB'
        time   = '1 h'
    }
    withName: 'EXTERNAL_VALIDATION' {
        cpus   = 2
        memory = '4 GB'
        time   = '30 min'
    }
    withName: 'ROBUSTNESS' {
        cpus   = 8
        memory = '16 GB'
        time   = '1 h'
    }
    withName: 'ENRICHMENT' {
        cpus   = 2
        memory = '4 GB'
        time   = '30 min'
    }
    withName: 'ANNOTATION' {
        cpus   = 1
        memory = '2 GB'
        time   = '30 min'
    }
    withName: 'PATHWAY_ANALYSIS' {
        cpus   = 2
        memory = '4 GB'
        time   = '30 min'
    }
    withName: 'MULTIOMICS' {
        cpus   = 2
        memory = '4 GB'
        time   = '30 min'
    }
    withName: 'REPORT_GEN_V2' {
        cpus   = 1
        memory = '2 GB'
        time   = '15 min'
    }

    errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
    maxRetries    = 2
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {

    local {
        process.executor = 'local'
    }

    // IISER Tirupati shared server — workshop_nf conda env
    iiser_server {
        process.executor = 'local'
        env.JAVA_HOME  = "/home/workshop/.conda/envs/workshop_nf/lib/jvm"
        env.PATH       = "/home/workshop/.conda/envs/workshop_nf/bin:\$PATH"
        process {
            cpus   = 16
            memory = '64 GB'
        }
    }

    // Lightweight test run (~10 min) — smaller models, fewer folds
    test {
        process.executor  = 'local'
        params {
            rf_n_estimators     = 50
            xgb_n_estimators    = 50
            n_outer_folds       = 3
            n_inner_folds       = 2
            stability_folds     = 5
            no_api              = true
        }
    }

    // Offline mode — no REST API calls (for air-gapped servers)
    offline {
        params {
            no_api = true
        }
    }
}

// ---------------------------------------------------------------------------
// Reporting and tracing
// ---------------------------------------------------------------------------
timeline {
    enabled   = true
    file      = "results/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "results/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "results/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,%mem,rss,peak_rss'
}

dag {
    enabled = false
}

// ---------------------------------------------------------------------------
// Work directory
// ---------------------------------------------------------------------------
workDir = "${projectDir}/work"
